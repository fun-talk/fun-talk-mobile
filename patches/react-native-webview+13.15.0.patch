index 0000000..46a5eda
--- /dev/null
+++ b/node_modules/react-native-webview/android/src/main/java/com/reactnativecommunity/webview/FunTalkNativeMicBridge.java
@@ -0,0 +1,179 @@
+package com.reactnativecommunity.webview;
+
+import android.annotation.SuppressLint;
+import android.media.AudioFormat;
+import android.media.AudioRecord;
+import android.media.MediaRecorder;
+import android.os.Process;
+import android.util.Base64;
+import android.util.Log;
+import android.webkit.JavascriptInterface;
+
+/**
+ * X5/WebView getUserMedia on some student tablets (Readboy T11) opens
+ * AudioSource.CAMCORDER / BACK_MIC, which the HAL routes to a dead camcorder
+ * mic. This bridge captures with VOICE_RECOGNITION (voice-rec-mic) instead
+ * and feeds PCM to a JS getUserMedia polyfill.
+ */
+public class FunTalkNativeMicBridge {
+    private static final String TAG = "FunTalkNativeMic";
+    private static final int CHANNEL = AudioFormat.CHANNEL_IN_MONO;
+    private static final int ENCODING = AudioFormat.ENCODING_PCM_16BIT;
+    private static final int NATIVE_RATE = 16000;
+
+    private final Object lock = new Object();
+    private AudioRecord recorder;
+    private Thread reader;
+    private volatile boolean running;
+    private byte[] pending = new byte[0];
+
+    @SuppressLint("MissingPermission")
+    @JavascriptInterface
+    public boolean start(int requestedSampleRate) {
+        stopInternal();
+        final int rate = requestedSampleRate > 0 ? requestedSampleRate : NATIVE_RATE;
+        int minBuf = AudioRecord.getMinBufferSize(rate, CHANNEL, ENCODING);
+        if (minBuf <= 0) {
+            Log.e(TAG, "invalid min buffer size=" + minBuf);
+            return false;
+        }
+        int buf = Math.max(minBuf * 2, 1280);
+        int[] sources = new int[] {
+            MediaRecorder.AudioSource.VOICE_RECOGNITION,
+            MediaRecorder.AudioSource.MIC,
+            MediaRecorder.AudioSource.DEFAULT,
+        };
+        AudioRecord rec = null;
+        int usedSource = -1;
+        for (int source : sources) {
+            try {
+                rec = new AudioRecord(source, rate, CHANNEL, ENCODING, buf);
+                if (rec.getState() == AudioRecord.STATE_INITIALIZED) {
+                    usedSource = source;
+                    break;
+                }
+                rec.release();
+                rec = null;
+            } catch (RuntimeException error) {
+                Log.w(TAG, "AudioRecord source " + source + " failed", error);
+                if (rec != null) {
+                    rec.release();
+                    rec = null;
+                }
+            }
+        }
+        if (rec == null) {
+            Log.e(TAG, "no AudioRecord source initialized");
+            return false;
+        }
+        synchronized (lock) {
+            recorder = rec;
+            pending = new byte[0];
+            running = true;
+        }
+        try {
+            rec.startRecording();
+        } catch (IllegalStateException error) {
+            Log.e(TAG, "startRecording failed", error);
+            stopInternal();
+            return false;
+        }
+        Log.i(TAG, "started source=" + usedSource + " rate=" + rate + " buf=" + buf);
+        final AudioRecord stream = rec;
+        reader = new Thread(() -> readLoop(stream, rate), "FunTalkNativeMic");
+        reader.start();
+        return true;
+    }
+
+    @JavascriptInterface
+    public String readPcm() {
+        synchronized (lock) {
+            if (pending.length == 0) {
+                return "";
+            }
+            String encoded = Base64.encodeToString(pending, Base64.NO_WRAP);
+            pending = new byte[0];
+            return encoded;
+        }
+    }
+
+    @JavascriptInterface
+    public void stop() {
+        stopInternal();
+    }
+
+    public void destroy() {
+        stopInternal();
+    }
+
+    private void readLoop(AudioRecord stream, int rate) {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_AUDIO);
+        byte[] chunk = new byte[Math.max(rate / 25 * 2, 1280)];
+        long frames = 0;
+        double rmsAcc = 0;
+        int rmsN = 0;
+        int cap = Math.max(rate / 5 * 2, 1600);
+        while (running) {
+            int n = stream.read(chunk, 0, chunk.length);
+            if (n <= 0) {
+                continue;
+            }
+            frames += n / 2;
+            long energy = 0;
+            for (int i = 0; i + 1 < n; i += 2) {
+                int sample = (chunk[i] & 0xff) | (chunk[i + 1] << 8);
+                if (sample > 32767) {
+                    sample -= 65536;
+                }
+                energy += (long) sample * sample;
+            }
+            rmsAcc += Math.sqrt(energy / (double) Math.max(1, n / 2)) / 32768.0;
+            rmsN += 1;
+            if (rmsN >= 25) {
+                Log.i(TAG, "rms=" + String.format("%.4f", rmsAcc / rmsN) + " frames=" + frames);
+                rmsAcc = 0;
+                rmsN = 0;
+            }
+            synchronized (lock) {
+                byte[] next = new byte[pending.length + n];
+                System.arraycopy(pending, 0, next, 0, pending.length);
+                System.arraycopy(chunk, 0, next, pending.length, n);
+                if (next.length > cap) {
+                    byte[] trimmed = new byte[cap];
+                    System.arraycopy(next, next.length - cap, trimmed, 0, cap);
+                    pending = trimmed;
+                } else {
+                    pending = next;
+                }
+            }
+        }
+    }
+
+    private void stopInternal() {
+        running = false;
+        Thread thread = reader;
+        reader = null;
+        if (thread != null) {
+            try {
+                thread.join(250);
+            } catch (InterruptedException ignored) {
+                Thread.currentThread().interrupt();
+            }
+        }
+        synchronized (lock) {
+            if (recorder != null) {
+                try {
+                    recorder.stop();
+                } catch (RuntimeException ignored) {
+                }
+                try {
+                    recorder.release();
+                } catch (RuntimeException ignored) {
+                }
+                recorder = null;
+            }
+            pending = new byte[0];
+        }
+        Log.i(TAG, "stopped");
+    }
+}
